{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spatial-agent.local/protocol/v2/events.schema.json",
  "title": "Spatial Agent protocol v2 envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "type",
    "event_id",
    "session_id",
    "thread_id",
    "timestamp",
    "payload"
  ],
  "properties": {
    "v": {
      "enum": [
        1,
        2
      ]
    },
    "type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string"
    },
    "thread_id": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "session.hello"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/sessionHelloPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "session.pair"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/sessionPairPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "workspace.bind"
          }
        }
      },
      "then": {
        "properties": {
          "thread_id": {
            "minLength": 1
          },
          "payload": {
            "$ref": "#/$defs/workspaceBindPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "file.list",
              "file.read"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "thread_id": {
            "minLength": 1
          },
          "payload": {
            "$ref": "#/$defs/filePathPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "diff.decision"
          }
        }
      },
      "then": {
        "properties": {
          "thread_id": {
            "minLength": 1
          },
          "payload": {
            "$ref": "#/$defs/diffDecisionPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "thread.combine"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/threadCombinePayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "thread.list",
              "thread.focus"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/emptyPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "thread.create"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/threadCreatePayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "thread.rename"
          }
        }
      },
      "then": {
        "properties": {
          "thread_id": {
            "minLength": 1
          },
          "payload": {
            "$ref": "#/$defs/threadRenamePayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "thread.archive",
              "run.cancel",
              "workspace.list",
              "tool.catalog",
              "diff.get",
              "thread.restore"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "thread_id": {
            "minLength": 1
          },
          "payload": {
            "$ref": "#/$defs/emptyPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "message.send"
          }
        }
      },
      "then": {
        "properties": {
          "thread_id": {
            "minLength": 1
          },
          "payload": {
            "$ref": "#/$defs/messageSendPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "approval.respond"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/approvalResponsePayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "voice.transcript.final"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/voiceTranscriptPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "thread.snapshot"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/threadSnapshotPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "thread.created",
              "thread.updated"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "thread_id": {
            "minLength": 1
          },
          "payload": {
            "$ref": "#/$defs/threadPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "agent.status"
          }
        }
      },
      "then": {
        "properties": {
          "thread_id": {
            "minLength": 1
          },
          "payload": {
            "$ref": "#/$defs/agentStatusPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "agent.message.started"
          }
        }
      },
      "then": {
        "properties": {
          "thread_id": {
            "minLength": 1
          },
          "payload": {
            "$ref": "#/$defs/messageStartedPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "agent.message.delta"
          }
        }
      },
      "then": {
        "properties": {
          "thread_id": {
            "minLength": 1
          },
          "payload": {
            "$ref": "#/$defs/messageDeltaPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "agent.message.completed"
          }
        }
      },
      "then": {
        "properties": {
          "thread_id": {
            "minLength": 1
          },
          "payload": {
            "$ref": "#/$defs/messageCompletedPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "approval.required"
          }
        }
      },
      "then": {
        "properties": {
          "thread_id": {
            "minLength": 1
          },
          "payload": {
            "$ref": "#/$defs/approvalRequiredPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "session.paired"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/sessionPairedPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "workspace.snapshot"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/workspaceSnapshotPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "run.workspace"
          }
        }
      },
      "then": {
        "properties": {
          "thread_id": {
            "minLength": 1
          },
          "payload": {
            "$ref": "#/$defs/runWorkspacePayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "diff.proposed"
          }
        }
      },
      "then": {
        "properties": {
          "thread_id": {
            "minLength": 1
          },
          "payload": {
            "$ref": "#/$defs/diffProposedPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "diff.applied",
              "diff.rejected"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "thread_id": {
            "minLength": 1
          },
          "payload": {
            "$ref": "#/$defs/diffDecisionResultPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "file.tree"
          }
        }
      },
      "then": {
        "properties": {
          "thread_id": {
            "minLength": 1
          },
          "payload": {
            "$ref": "#/$defs/fileTreePayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "file.content"
          }
        }
      },
      "then": {
        "properties": {
          "thread_id": {
            "minLength": 1
          },
          "payload": {
            "$ref": "#/$defs/fileContentPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "tool.catalog"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/toolCatalogPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "error"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/errorPayload"
          }
        }
      }
    },
    {
      "if": {"properties": {"type": {"const": "mission.create"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/missionCommandPayload"}}}
    },
    {
      "if": {"properties": {"type": {"const": "mission.status"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/missionCommandPayload"}}}
    },
    {
      "if": {"properties": {"type": {"const": "mission.cancel"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/missionCommandPayload"}}}
    },
    {
      "if": {"properties": {"type": {"const": "mission.merge"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/missionCommandPayload"}}}
    },
    {
      "if": {"properties": {"type": {"const": "agent.spawn"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/missionCommandPayload"}}}
    },
    {
      "if": {"properties": {"type": {"const": "agent.status"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/missionCommandPayload"}}}
    },
    {
      "if": {"properties": {"type": {"const": "agent.compare"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/missionCommandPayload"}}}
    },
    {
      "if": {"properties": {"type": {"const": "mission.created"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/missionEventPayload"}}}
    },
    {
      "if": {"properties": {"type": {"const": "mission.planned"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/missionEventPayload"}}}
    },
    {
      "if": {"properties": {"type": {"const": "mission.compare"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/missionEventPayload"}}}
    },
    {
      "if": {"properties": {"type": {"const": "mission.merged"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/missionEventPayload"}}}
    },
    {
      "if": {"properties": {"type": {"const": "mission.budget_exceeded"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/missionEventPayload"}}}
    },
    {
      "if": {"properties": {"type": {"const": "agent.spawned"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/missionEventPayload"}}}
    },
    {
      "if": {"properties": {"type": {"const": "agent.usage"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/missionEventPayload"}}}
    }
  ],
  "$defs": {
    "emptyPayload": {
      "type": "object",
      "additionalProperties": false
    },
    "missionCommandPayload": {
      "type": "object"
    },
    "missionEventPayload": {
      "type": "object"
    },
    "sessionHelloPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version"
      ],
      "properties": {
        "client": {
          "type": "string",
          "maxLength": 120
        },
        "protocol_version": {
          "enum": [
            1,
            2
          ]
        },
        "auth_token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "sessionPairPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "device_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "sessionPairedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device_id",
        "device_name",
        "token"
      ],
      "properties": {
        "device_id": {
          "type": "string",
          "minLength": 1
        },
        "device_name": {
          "type": "string",
          "minLength": 1
        },
        "token": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "workspaceBindPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workspace_id": {
          "type": "string",
          "maxLength": 80
        }
      }
    },
    "filePathPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 512
        }
      }
    },
    "diffDecisionPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "decision"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "decision": {
          "type": "string",
          "enum": [
            "apply",
            "reject"
          ]
        }
      }
    },
    "threadCombinePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "thread_ids"
      ],
      "properties": {
        "thread_ids": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "path",
        "base_branch"
      ],      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "base_branch": {
          "type": "string"
        }
      }
    },
    "workspaceSnapshotPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspaces"
      ],
      "properties": {
        "workspaces": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/workspace"
          }
        }
      }
    },
    "runWorkspacePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "workspace_id",
        "branch",
        "base_commit"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "workspace_id": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "base_commit": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "diffHunk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "header",
        "old_start",
        "new_start",
        "lines"
      ],
      "properties": {
        "header": {
          "type": "string"
        },
        "old_start": {
          "type": "integer"
        },
        "new_start": {
          "type": "integer"
        },
        "lines": {
          "type": "array",
          "maxItems": 400,
          "items": {
            "type": "string",
            "maxLength": 400
          }
        }
      }
    },
    "fileDiff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "change",
        "additions",
        "deletions",
        "hunks"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "change": {
          "type": "string",
          "enum": [
            "added",
            "modified",
            "deleted",
            "renamed",
            "binary"
          ]
        },
        "additions": {
          "type": "integer",
          "minimum": 0
        },
        "deletions": {
          "type": "integer",
          "minimum": 0
        },
        "hunks": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/diffHunk"
          }
        }
      }
    },
    "diffProposedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "files",
        "truncated"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "truncated": {
          "type": "boolean"
        },
        "files": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/fileDiff"
          }
        }
      }
    },
    "diffDecisionResultPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "decision"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "type": "string",
          "enum": [
            "apply",
            "reject"
          ]
        },
        "branch": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        }
      }
    },
    "fileEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "path",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "dir",
            "file"
          ]
        },
        "size": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "fileTreePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "entries"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "entries": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/fileEntry"
          }
        }
      }
    },
    "fileContentPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "size",
        "binary",
        "content"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "binary": {
          "type": "boolean"
        },
        "truncated": {
          "type": "boolean"
        },
        "content": {
          "type": "string"
        }
      }
    },
    "toolInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "permission_level"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "permission_level": {
          "type": "string",
          "enum": [
            "safe_read",
            "sensitive_read",
            "write_reversible",
            "write_external",
            "destructive",
            "forbidden"
          ]
        },
        "source": {
          "type": "string"
        },
        "server_id": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "toolCatalogPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tools"
      ],
      "properties": {
        "tools": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/toolInfo"
          }
        },
        "mcp_servers": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "threadCreatePayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "threadRenamePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "approvalResponsePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval_id",
        "decision"
      ],
      "properties": {
        "approval_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "decision": {
          "type": "string",
          "enum": [
            "approve",
            "deny"
          ]
        }
      }
    },
    "voiceTranscriptPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transcript"
      ],
      "properties": {
        "transcript": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "idle",
        "listening",
        "working",
        "waiting_user",
        "complete",
        "error"
      ]
    },
    "role": {
      "type": "string",
      "enum": [
        "user",
        "assistant",
        "system",
        "tool"
      ]
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "thread_id",
        "role",
        "content",
        "created_at",
        "is_streaming",
        "metadata"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "thread_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "$ref": "#/$defs/role"
        },
        "content": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "is_streaming": {
          "type": "boolean"
        },
        "metadata": {
          "type": "object"
        }
      }
    },
    "thread": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "status",
        "messages",
        "unread_count",
        "created_at",
        "updated_at",
        "parent_thread_id",
        "tags",
        "metadata",
        "is_pinned"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/message"
          }
        },
        "unread_count": {
          "type": "integer",
          "minimum": 0
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "parent_thread_id": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "metadata": {
          "type": "object"
        },
        "is_pinned": {
          "type": "boolean"
        }
      }
    },
    "messageSendPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content"
      ],
      "properties": {
        "content": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "threadSnapshotPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "threads"
      ],
      "properties": {
        "threads": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/thread"
          }
        }
      }
    },
    "threadPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "thread"
      ],
      "properties": {
        "thread": {
          "$ref": "#/$defs/thread"
        }
      }
    },
    "agentStatusPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/status"
        },
        "run_id": {
          "type": "string"
        }
      }
    },
    "messageStartedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_id",
        "role"
      ],
      "properties": {
        "message_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "$ref": "#/$defs/role"
        },
        "run_id": {
          "type": "string"
        },
        "content": {
          "type": "string"
        }
      }
    },
    "messageDeltaPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_id",
        "delta",
        "sequence"
      ],
      "properties": {
        "message_id": {
          "type": "string",
          "minLength": 1
        },
        "delta": {
          "type": "string"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "run_id": {
          "type": "string"
        }
      }
    },
    "messageCompletedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_id"
      ],
      "properties": {
        "message_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string"
        },
        "cancelled": {
          "type": "boolean"
        },
        "unread_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "approvalRequiredPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval_id",
        "tool_name",
        "summary"
      ],
      "properties": {
        "approval_id": {
          "type": "string",
          "minLength": 1
        },
        "tool_name": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "tool_id": {
          "type": "string",
          "minLength": 1
        },
        "permission_level": {
          "type": "string",
          "enum": [
            "safe_read",
            "sensitive_read",
            "write_reversible",
            "write_external",
            "destructive",
            "forbidden"
          ]
        },
        "impact_preview": {
          "$ref": "#/$defs/impactPreview"
        }
      }
    },
    "impactPreview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route",
        "scope",
        "side_effect",
        "reversibility",
        "external"
      ],
      "properties": {
        "route": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "side_effect": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "reversibility": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "external": {
          "type": "boolean"
        }
      }
    },
    "errorPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string"
        }
      }
    }
  }
}
