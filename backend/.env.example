# Copy this file to .env. The backend reads it without shell evaluation.
# Select fake, one hosted provider, or council for explicit dual-provider comparison.
# Council sends the same eligible context to BOTH providers and can roughly double cost.
SPATIAL_AGENT_PROVIDER=fake

# OpenAI Responses API (an API key, not a ChatGPT subscription cookie/session).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

# Anthropic Messages API.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

SPATIAL_AGENT_HOST=127.0.0.1
SPATIAL_AGENT_PORT=8787
SPATIAL_AGENT_DB=data/spatial_agent.db
SPATIAL_AGENT_MAX_OUTPUT_TOKENS=1024

# Rev 2 daemon foundation.
# The repositories agents may work in, one git worktree per agent run.
SPATIAL_AGENT_WORKSPACES_FILE=data/workspaces.json
# MCP server definitions (stdio and streamable HTTP).
SPATIAL_AGENT_MCP_CONFIG=data/mcp.json
# Required for any non-loopback bind; LAN devices pair with a short code.
SPATIAL_AGENT_AUTH_REQUIRED=0
SPATIAL_AGENT_TLS_CERT=
SPATIAL_AGENT_TLS_KEY=
SPATIAL_AGENT_PAIRING_TTL_SECONDS=600
# Optional comma-separated first tokens allowed to run without per-command review.
SPATIAL_AGENT_SHELL_ALLOWLIST=
