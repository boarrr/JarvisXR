# Copy this file to .env. The backend reads it without shell evaluation.
# Select fake, one hosted provider, or council for explicit dual-provider comparison.
# Council sends the same eligible context to BOTH providers and can roughly double cost.
SPATIAL_AGENT_PROVIDER=fake

# OpenAI Responses API (an API key, not a ChatGPT subscription cookie/session).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

# Anthropic Messages API.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

SPATIAL_AGENT_HOST=127.0.0.1
SPATIAL_AGENT_PORT=8787
SPATIAL_AGENT_DB=data/spatial_agent.db
SPATIAL_AGENT_MAX_OUTPUT_TOKENS=1024
