[sub_resource type="Shader" id="Shader_grid"]
code = "shader_type spatial;\nrender_mode unshaded, blend_add, cull_disabled;\n\nuniform vec4 grid_color : source_color = vec4(0.02, 0.55, 0.7, 1.0);\n\nvoid fragment() {\n    vec2 fine_coord = UV * 32.0;\n    vec2 fine_width = fwidth(fine_coord);\n    vec2 fine_grid = abs(fract(fine_coord - 0.5) - 0.5) / max(fine_width, vec2(0.001));\n    float fine_line = 1.0 - min(min(fine_grid.x, fine_grid.y), 1.0);\n\n    vec2 major_coord = UV * 8.0;\n    vec2 major_width = fwidth(major_coord);\n    vec2 major_grid = abs(fract(major_coord - 0.5) - 0.5) / max(major_width, vec2(0.001));\n    float major_line = 1.0 - min(min(major_grid.x, major_grid.y), 1.0);\n\n    float radial_fade = 1.0 - smoothstep(0.22, 0.72, distance(UV, vec2(0.5)));\n    float intensity = (fine_line * 0.10 + major_line * 0.24) * radial_fade;\n    ALBEDO = grid_color.rgb;\n    EMISSION = grid_color.rgb * intensity * 1.8;\n    ALPHA = intensity;\n}\n"

