; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Spatial Agent XR"
config/version="1.0.49"
run/main_scene="res://scenes/app/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[audio]

driver/enable_input=true

[autoload]

LogRelay="*res://autoload/log_relay.gd"
AppState="*res://autoload/app_state.gd"
EventBus="*res://autoload/event_bus.gd"
ServiceRegistry="*res://autoload/service_registry.gd"

[display]

window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.012, 0.016, 0.024, 1)

[spatial_agent]

backend_mode="fake"
backend_mode.android="websocket"
backend_websocket_url="ws://127.0.0.1:8787/ws"
backend_websocket_fallback="wss://192.168.0.17:8787/ws"
baked_ca_path="res://certs/dev_ca.crt"
allow_unsafe_tls=false
perf_probe=true
gesture_telemetry=false
gesture_hud=true
xr_refresh_rate=72.0
speech_enabled=false
whisper_cli_path="whisper-cli"
whisper_model_path=""
speech_retain_recordings=false
speech_max_recording_seconds=20.0
spatial_audio_enabled=true

[xr]

openxr/environment_blend_mode=2
openxr/startup_alert=false
openxr/extensions/hand_tracking=true
openxr/extensions/hand_tracking_unobstructed_data_source=true
openxr/extensions/hand_interaction_profile=true
openxr/extensions/meta/passthrough=true
openxr/enabled.android=true
shaders/enabled.android=true
