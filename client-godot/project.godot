[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.012, 0.016, 0.024, 1)

[spatial_agent]

desktop_hand_lab=true
backend_mode="fake"
backend_mode.android="websocket"
backend_websocket_url="ws://127.0.0.1:8787/ws"
backend_websocket_fallback=""
allow_unsafe_tls=false
perf_probe=true
gesture_telemetry=false
gesture_hud=true
xr_refresh_rate=72.0
speech_enabled=false
whisper_cli_path="whisper-cli"
whisper_model_path=""
speech_retain_recordings=false
speech_max_recording_seconds=20.0
spatial_audio_enabled=true

[xr]

openxr/environment_blend_mode=2
openxr/startup_alert=false
openxr/extensions/hand_tracking=true
openxr/extensions/hand_tracking_unobstructed_data_source=true
openxr/extensions/hand_interaction_profile=true
openxr/extensions/meta/passthrough=true
openxr/enabled.android=true
shaders/enabled.android=true
